#!/usr/bin/env bash
# Opens NotchCue at the top centre of the screen, around the notch.
# In a source checkout it builds the app on first run or after the source changes;
# inside an installed NotchCue.app (Contents/Resources/notchcue) it just opens that app.
#
#   notchcue script.txt                     # follows your voice
#   notchcue notes.md                       # Markdown, Word, RTF, HTML and PDF work too
#   notchcue script.txt --steady --wpm 170  # steady scroll
#   notchcue --text "Some sample text"
#   echo "Text from a pipe" | notchcue -
#   notchcue                                # welcome panel: drop, open or paste a script
#
# Returns straight away and leaves the window open. Add --wait to block until it closes.
# Run with --help for all options and keys.
set -euo pipefail

# Resolve symlinks (e.g. ~/.local/bin/notchcue or Homebrew's link -> this file).
self="${BASH_SOURCE[0]}"
while [[ -L "$self" ]]; do
  link="$(readlink "$self")"
  [[ "$link" == /* ]] && self="$link" || self="$(dirname "$self")/$link"
done
root="$(cd "$(dirname "$self")" && pwd)"

if [[ "$root" == */Contents/Resources && -x "$root/../MacOS/notchcue" ]]; then
  # Installed copy: this script lives inside NotchCue.app, so just open that app.
  app="$(cd "$root/../.." && pwd)"
  bin="$app/Contents/MacOS/notchcue"
else
  # Source checkout: build into build/NotchCue.app when the source has changed.
  plist="$root/Info.plist"
  app="$root/build/NotchCue.app"
  bin="$app/Contents/MacOS/notchcue"
  installed="$HOME/Applications/NotchCue.app"

  needs_build=0
  [[ -x "$bin" && "$plist" -ot "$bin" && "$self" -ot "$bin" && "$root/scripts/build-app.sh" -ot "$bin" ]] || needs_build=1
  for src in "$root"/Sources/*.swift; do
    [[ "$src" -nt "$bin" ]] && needs_build=1
  done

  if [[ $needs_build == 1 ]]; then
    echo "Building NotchCue..." >&2
    "$root/scripts/build-app.sh" "$app"
    # Sign with a stable identity so macOS remembers the microphone and speech
    # permissions across rebuilds. NOTCHCUE_SIGN_IDENTITY overrides the choice
    # ("-" for ad-hoc); otherwise the first Apple Development certificate is
    # used, or an ad-hoc signature when there isn't one.
    identity="${NOTCHCUE_SIGN_IDENTITY:-}"
    if [[ -z "$identity" ]]; then
      identity="$(security find-identity -v -p codesigning 2>/dev/null | awk '/"Apple Development/ { print $2; exit }')"
    fi
    identity="${identity:--}"
    if ! codesign --force --sign "$identity" "$app" >/dev/null 2>&1; then
      echo "Couldn't sign with \"$identity\"; using an ad-hoc signature (macOS will ask for permissions again after each rebuild)." >&2
      codesign --force --sign - "$app" >/dev/null 2>&1
    fi
    # Keep the copy in ~/Applications (from `make install`) up to date, unless
    # it's a notarised release (Developer ID), which a local build shouldn't replace.
    if [[ -d "$installed" ]] \
      && [[ "$(plutil -extract CFBundleIdentifier raw "$installed/Contents/Info.plist" 2>/dev/null)" == "ai.lycana.notchcue" ]] \
      && [[ "$(codesign -dv --verbose=2 "$installed" 2>&1)" != *"Authority=Developer ID Application"* ]]; then
      rm -rf "$installed"
      ditto "$app" "$installed"
    fi
  fi
fi

wait=0
validate=0
args=()
prev=""
for arg in "$@"; do
  case "$arg" in
    --wait) wait=1 ;;
    --validate) validate=1; args+=("$arg") ;;
    -h|--help) exec "$bin" --help ;;
    --self-test) exec "$bin" --self-test ;;
    -)
      # Save piped text to a file so the window can outlive this command.
      tmp="$(mktemp -t notchcue).txt"
      cat > "$tmp"
      args+=("$tmp")
      ;;
    *)
      # The app starts in another directory, so pass the script file as a full path.
      if [[ "$arg" != -* && "$prev" != --* && -e "$arg" ]]; then
        arg="$(cd "$(dirname "$arg")" && pwd)/$(basename "$arg")"
      fi
      args+=("$arg")
      ;;
  esac
  prev="$arg"
done

# Catch bad options or unreadable files here, where the error is visible.
"$bin" ${args[@]+"${args[@]}"} --validate
[[ $validate == 1 ]] && exit 0

# Close any NotchCue that's already open (from here or ~/Applications), so there's only one.
pkill -f "NotchCue.app/Contents/MacOS/notchcue" 2>/dev/null || true

if [[ $wait == 1 ]]; then
  open -W -n "$app" --args ${args[@]+"${args[@]}"}
else
  open -n "$app" --args ${args[@]+"${args[@]}"}
  echo "NotchCue opened at the top of the screen. Esc closes it; the menu bar icon has the rest."
fi
